{
  "name": "catalog-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @catalog/contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @catalog/contracts build && pnpm -r test",
    "test:integration": "pnpm --filter @catalog/contracts build && pnpm -r test:integration",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}

# Copy to .env (cp .env.example .env). Local development values only — no real secrets.
# In AWS these values come from Secrets Manager and ECS task definitions (see docs/deployment.md).

# PostgreSQL: one local container, two logical databases with separate credentials.
POSTGRES_ADMIN_PASSWORD=local-admin-password
CATALOG_DB_PASSWORD=local-catalog-password
NOTIFICATION_DB_PASSWORD=local-notification-password

# Catalog Service
# fakestore = live Fake Store API (needs internet); fixture = committed offline snapshot.
PRODUCT_PROVIDER=fakestore
# Exactly five distinct product ids shown on the homepage (business-configured, ASM-001).
FEATURED_PRODUCT_IDS=1,5,9,12,18
ENQUIRY_RATE_LIMIT_PER_MINUTE=10
# Per-IP limit for GET /api/catalog/enquiries/{id} status lookups.
ENQUIRY_STATUS_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info

# Shared service-to-service bearer token for the internal Catalog callback (ADR-018).
# Local placeholder only; in AWS it is injected from Secrets Manager.
INTERNAL_API_TOKEN=local-internal-token-change-me

# Notification Service: trusted, server-side email routing (ASM-012). Captured locally by Mailpit.
EMAIL_FROM=catalog-notifications@example.com
SALES_RECIPIENT_PRODUCT=product-sales@example.com
SALES_RECIPIENT_CATEGORY=category-sales@example.com

# Host ports. PostgreSQL and SQS are bound to 127.0.0.1 for integration tests only.
POSTGRES_HOST_PORT=55432
SQS_HOST_PORT=59324
MAILPIT_UI_PORT=8025

# Browser entry point (frontend + /api/catalog gateway).
GATEWAY_PORT=8080
